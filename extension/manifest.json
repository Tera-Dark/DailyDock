{
  "manifest_version": 3,
  "name": "DailyDock - 每日签到与待办",
  "version": "0.1.0",
  "description": "轻量每日签到与待办：本地管理、定时提醒、零后端。",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "DailyDock",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}